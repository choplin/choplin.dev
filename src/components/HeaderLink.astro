---
import type { HTMLAttributes } from 'astro/types';

type Props = HTMLAttributes<'a'>;

const { href, class: className, ...props } = Astro.props;
// Strip a leading non-default locale segment (e.g. /ja) so active-state
// matching works the same on English and Japanese routes.
const stripLocale = (p: string) => p.replace(/^\/ja(?=\/|$)/, '') || '/';
const normalizePath = (p: string) => {
	const base = import.meta.env.BASE_URL.replace(/\/$/, '');
	const withoutBase = base && p.startsWith(base) ? p.slice(base.length) : p;
	return `/${withoutBase}`.replace(/\/+/g, '/').replace(/\/$/, '') || '/';
};
const pathname = stripLocale(normalizePath(Astro.url.pathname));
const target = stripLocale(normalizePath(String(href)));
const subpath = pathname.match(/[^\/]+/g);
const isActive = target === pathname || target === '/' + (subpath?.[0] || '');
---

<a href={href} class:list={[className, { active: isActive }]} {...props}>
	<slot />
</a>
<style>
	a {
		display: inline-block;
		text-decoration: none;
	}
	a.active {
		font-weight: bolder;
		text-decoration: underline;
	}
</style>
